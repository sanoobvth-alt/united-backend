generator client {
  provider               = "prisma-client-js"
  output                 = "../generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "js"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

enum PolicyStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum InsurerType {
  UNITED
  THIRD_PARTY
}

enum RenewalStatus {
  UPCOMING
  DUE_SOON
  DUE_TODAY
  EXPIRED
  RENEWED
  NOT_RENEWED
}

enum ClaimStatus {
  REPORTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SETTLED
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum CommissionStatus {
  PENDING
  PAID
  CANCELLED
}

enum InsuranceClass {
  FIRST_CLASS
  THIRD_PARTY
}

enum AccountEntryType {
  CHARGE
  PAYMENT
  CREDIT
}

enum ClosingStatus {
  DRAFT
  SUBMITTED
}

model Admin {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  email        String       @unique
  passwordHash String
  status       RecordStatus @default(ACTIVE)
  branches     Branch[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Branch {
  id             String         @id @default(uuid()) @db.Uuid
  adminId        String         @db.Uuid
  admin          Admin          @relation(fields: [adminId], references: [id])
  name           String
  code           String         @unique
  phone          String?
  email          String?
  address        String?
  status         RecordStatus   @default(ACTIVE)
  username       String         @unique
  passwordHash   String
  staff          Staff[]
  customers      Customer[]
  leads          Lead[]
  policies       Policy[]
  renewals       Renewal[]
  claims         Claim[]
  followUps      FollowUp[]
  documents      Document[]
  activities     Activity[]
  commissions    Commission[]
  accountEntries AccountEntry[]
  expenses       Expense[]
  dailyClosings  DailyClosing[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([adminId])
  @@index([status])
}

model Staff {
  id          String       @id @default(uuid()) @db.Uuid
  branchId    String       @db.Uuid
  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name        String
  phone       String
  email       String?
  designation String?
  status      RecordStatus @default(ACTIVE)
  joiningDate DateTime?
  customers   Customer[]
  leads       Lead[]
  followUps   FollowUp[]
  activities  Activity[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([branchId, status])
}

model Customer {
  id             String            @id @default(uuid()) @db.Uuid
  branchId       String            @db.Uuid
  branch         Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staffId        String?           @db.Uuid
  staff          Staff?            @relation(fields: [staffId], references: [id], onDelete: SetNull)
  name           String
  phone          String
  email          String?
  dob            DateTime?
  address        String?
  notes          String?
  status         RecordStatus      @default(ACTIVE)
  policies       Policy[]
  claims         Claim[]
  followUps      FollowUp[]
  documents      Document[]
  activities     Activity[]
  commissions    Commission[]
  accountEntries AccountEntry[]
  convertedLead  Lead?             @relation("LeadConversion")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([branchId, name])
  @@index([branchId, phone])
}

model Lead {
  id                  String     @id @default(uuid()) @db.Uuid
  branchId            String     @db.Uuid
  branch              Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staffId             String?    @db.Uuid
  staff               Staff?     @relation(fields: [staffId], references: [id], onDelete: SetNull)
  name                String
  phone               String
  email               String?
  source              String?
  interest            String?
  status              LeadStatus @default(NEW)
  nextFollowUpAt      DateTime?
  notes               String?
  convertedCustomerId String?    @unique @db.Uuid
  convertedCustomer   Customer?  @relation("LeadConversion", fields: [convertedCustomerId], references: [id], onDelete: SetNull)
  convertedAt         DateTime?
  followUps           FollowUp[]
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([branchId, status])
}

model Policy {
  id             String          @id @default(uuid()) @db.Uuid
  branchId       String          @db.Uuid
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customerId     String          @db.Uuid
  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  policyNumber   String
  insurerType    InsurerType     @default(THIRD_PARTY)
  insurerId      String?         @db.Uuid
  insurerRecord  Insurer?        @relation(fields: [insurerId], references: [id], onDelete: Restrict)
  product        String
  premium        Decimal         @db.Decimal(12, 2)
  startDate      DateTime
  expiryDate     DateTime
  status         PolicyStatus    @default(ACTIVE)
  insuranceClass InsuranceClass?
  vehicleNumber  String?
  vehicleType    String?
  vehicleDetails String?
  amountPartOne  Decimal?        @db.Decimal(12, 2)
  amountPartTwo  Decimal?        @db.Decimal(12, 2)
  renewals       Renewal[]
  claims         Claim[]
  documents      Document[]
  commissions    Commission[]
  accountEntries AccountEntry[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([branchId, policyNumber])
  @@index([branchId, expiryDate])
  @@index([customerId])
  @@index([insurerId])
  @@index([insurerType])
}

model Insurer {
  id        String      @id @default(uuid()) @db.Uuid
  name      String      @unique
  isActive  Boolean     @default(true)
  policies  Policy[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([isActive, name])
}

model Renewal {
  id            String        @id @default(uuid()) @db.Uuid
  branchId      String        @db.Uuid
  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  policyId      String        @db.Uuid
  policy        Policy        @relation(fields: [policyId], references: [id], onDelete: Cascade)
  dueDate       DateTime
  status        RenewalStatus @default(UPCOMING)
  reminderStage String?
  renewedAt     DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([branchId, dueDate, status])
}

model Claim {
  id          String      @id @default(uuid()) @db.Uuid
  branchId    String      @db.Uuid
  branch      Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customerId  String      @db.Uuid
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  policyId    String?     @db.Uuid
  policy      Policy?     @relation(fields: [policyId], references: [id], onDelete: SetNull)
  claimNumber String?
  claimDate   DateTime
  status      ClaimStatus @default(REPORTED)
  amount      Decimal?    @db.Decimal(12, 2)
  notes       String?
  documents   Document[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([branchId, status])
  @@index([customerId])
}

model FollowUp {
  id          String         @id @default(uuid()) @db.Uuid
  branchId    String         @db.Uuid
  branch      Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customerId  String?        @db.Uuid
  customer    Customer?      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leadId      String?        @db.Uuid
  lead        Lead?          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  staffId     String?        @db.Uuid
  staff       Staff?         @relation(fields: [staffId], references: [id], onDelete: SetNull)
  title       String
  dueAt       DateTime
  status      FollowUpStatus @default(PENDING)
  notes       String?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([branchId, dueAt, status])
}

model Document {
  id         String    @id @default(uuid()) @db.Uuid
  branchId   String    @db.Uuid
  branch     Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customerId String?   @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  policyId   String?   @db.Uuid
  policy     Policy?   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  claimId    String?   @db.Uuid
  claim      Claim?    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  type       String
  fileName   String
  fileUrl    String
  uploadedAt DateTime  @default(now())

  @@index([branchId, uploadedAt])
}

model Activity {
  id          String    @id @default(uuid()) @db.Uuid
  branchId    String    @db.Uuid
  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customerId  String?   @db.Uuid
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staffId     String?   @db.Uuid
  staff       Staff?    @relation(fields: [staffId], references: [id], onDelete: SetNull)
  type        String
  title       String
  description String?
  metadata    Json?
  createdAt   DateTime  @default(now())

  @@index([branchId, createdAt])
  @@index([customerId, createdAt])
}

model Commission {
  id         String           @id @default(uuid()) @db.Uuid
  branchId   String           @db.Uuid
  branch     Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  policyId   String?          @db.Uuid
  policy     Policy?          @relation(fields: [policyId], references: [id], onDelete: SetNull)
  customerId String?          @db.Uuid
  customer   Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  amount     Decimal          @db.Decimal(12, 2)
  status     CommissionStatus @default(PENDING)
  earnedAt   DateTime         @default(now())
  paidAt     DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([branchId, status, earnedAt])
}

model AccountEntry {
  id          String           @id @default(uuid()) @db.Uuid
  branchId    String           @db.Uuid
  branch      Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customerId  String           @db.Uuid
  customer    Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  policyId    String?          @db.Uuid
  policy      Policy?          @relation(fields: [policyId], references: [id], onDelete: SetNull)
  type        AccountEntryType
  amount      Decimal          @db.Decimal(12, 2)
  description String?
  occurredAt  DateTime         @default(now())
  createdAt   DateTime         @default(now())

  @@index([branchId, occurredAt])
  @@index([customerId, occurredAt])
  @@index([policyId])
}

model Expense {
  id          String   @id @default(uuid()) @db.Uuid
  branchId    String   @db.Uuid
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category    String
  amount      Decimal  @db.Decimal(12, 2)
  description String?
  expenseDate DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([branchId, expenseDate])
}

model DailyClosing {
  id                     String        @id @default(uuid()) @db.Uuid
  branchId               String        @db.Uuid
  branch                 Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  closingDate            DateTime      @db.Date
  openingBalance         Decimal?      @db.Decimal(12, 2)
  cashReceived           Decimal       @default(0) @db.Decimal(12, 2)
  bankReceived           Decimal       @default(0) @db.Decimal(12, 2)
  expensesPaid           Decimal       @default(0) @db.Decimal(12, 2)
  closingBalanceDeclared Decimal?      @db.Decimal(12, 2)
  notes                  String?
  status                 ClosingStatus @default(DRAFT)
  submittedAt            DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@unique([branchId, closingDate])
  @@index([closingDate, status])
}
