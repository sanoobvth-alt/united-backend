generator client {
  provider               = "prisma-client"
  output                 = "../generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}
enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}
enum PolicyStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}
enum RenewalStatus {
  UPCOMING
  DUE_SOON
  DUE_TODAY
  EXPIRED
  RENEWED
  NOT_RENEWED
}
enum ClaimStatus {
  REPORTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SETTLED
}
enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}
enum CommissionStatus {
  PENDING
  PAID
  CANCELLED
}

model Admin {
  id String @id @default(uuid()) @db.Uuid
  name String
  email String @unique
  passwordHash String
  status RecordStatus @default(ACTIVE)
  branches Branch[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id String @id @default(uuid()) @db.Uuid
  adminId String @db.Uuid
  admin Admin @relation(fields: [adminId], references: [id])
  name String
  code String @unique
  phone String?
  email String?
  address String?
  status RecordStatus @default(ACTIVE)
  username String @unique
  passwordHash String
  staff Staff[]
  customers Customer[]
  leads Lead[]
  policies Policy[]
  renewals Renewal[]
  claims Claim[]
  followUps FollowUp[]
  documents Document[]
  activities Activity[]
  commissions Commission[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([adminId])
  @@index([status])
}

model Staff {
  id String @id @default(uuid()) @db.Uuid
  branchId String @db.Uuid
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name String
  phone String
  email String?
  designation String?
  status RecordStatus @default(ACTIVE)
  joiningDate DateTime?
  customers Customer[]
  leads Lead[]
  followUps FollowUp[]
  activities Activity[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([branchId, status])
}

model Customer {
  id String @id @default(uuid()) @db.Uuid
  branchId String @db.Uuid
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staffId String? @db.Uuid
  staff Staff? @relation(fields: [staffId], references: [id], onDelete: SetNull)
  name String
  phone String
  email String?
  dob DateTime?
  gender String?
  address String?
  notes String?
  status RecordStatus @default(ACTIVE)
  policies Policy[]
  claims Claim[]
  followUps FollowUp[]
  documents Document[]
  activities Activity[]
  commissions Commission[]
  convertedLead Lead? @relation("LeadConversion")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([branchId, name])
  @@index([branchId, phone])
}

model Lead {
  id String @id @default(uuid()) @db.Uuid
  branchId String @db.Uuid
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staffId String? @db.Uuid
  staff Staff? @relation(fields: [staffId], references: [id], onDelete: SetNull)
  name String
  phone String
  email String?
  source String?
  interest String?
  status LeadStatus @default(NEW)
  nextFollowUpAt DateTime?
  notes String?
  convertedCustomerId String? @unique @db.Uuid
  convertedCustomer Customer? @relation("LeadConversion", fields: [convertedCustomerId], references: [id], onDelete: SetNull)
  convertedAt DateTime?
  followUps FollowUp[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([branchId, status])
}

model Policy {
  id String @id @default(uuid()) @db.Uuid
  branchId String @db.Uuid
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customerId String @db.Uuid
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  policyNumber String
  insurer String
  product String
  policyType String
  premium Decimal @db.Decimal(12, 2)
  startDate DateTime
  expiryDate DateTime
  status PolicyStatus @default(ACTIVE)
  renewals Renewal[]
  claims Claim[]
  documents Document[]
  commissions Commission[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([branchId, policyNumber])
  @@index([branchId, expiryDate])
  @@index([customerId])
}

model Renewal {
  id String @id @default(uuid()) @db.Uuid
  branchId String @db.Uuid
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  policyId String @db.Uuid
  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  dueDate DateTime
  status RenewalStatus @default(UPCOMING)
  reminderStage String?
  renewedAt DateTime?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([branchId, dueDate, status])
}

model Claim {
  id String @id @default(uuid()) @db.Uuid
  branchId String @db.Uuid
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customerId String @db.Uuid
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  policyId String? @db.Uuid
  policy Policy? @relation(fields: [policyId], references: [id], onDelete: SetNull)
  claimNumber String?
  claimDate DateTime
  status ClaimStatus @default(REPORTED)
  amount Decimal? @db.Decimal(12, 2)
  notes String?
  documents Document[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([branchId, status])
  @@index([customerId])
}

model FollowUp {
  id String @id @default(uuid()) @db.Uuid
  branchId String @db.Uuid
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customerId String? @db.Uuid
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leadId String? @db.Uuid
  lead Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)
  staffId String? @db.Uuid
  staff Staff? @relation(fields: [staffId], references: [id], onDelete: SetNull)
  title String
  dueAt DateTime
  status FollowUpStatus @default(PENDING)
  notes String?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([branchId, dueAt, status])
}

model Document {
  id String @id @default(uuid()) @db.Uuid
  branchId String @db.Uuid
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customerId String? @db.Uuid
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  policyId String? @db.Uuid
  policy Policy? @relation(fields: [policyId], references: [id], onDelete: Cascade)
  claimId String? @db.Uuid
  claim Claim? @relation(fields: [claimId], references: [id], onDelete: Cascade)
  type String
  fileName String
  fileUrl String
  uploadedAt DateTime @default(now())
  @@index([branchId, uploadedAt])
}

model Activity {
  id String @id @default(uuid()) @db.Uuid
  branchId String @db.Uuid
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customerId String? @db.Uuid
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staffId String? @db.Uuid
  staff Staff? @relation(fields: [staffId], references: [id], onDelete: SetNull)
  type String
  title String
  description String?
  metadata Json?
  createdAt DateTime @default(now())
  @@index([branchId, createdAt])
  @@index([customerId, createdAt])
}

model Commission {
  id String @id @default(uuid()) @db.Uuid
  branchId String @db.Uuid
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  policyId String? @db.Uuid
  policy Policy? @relation(fields: [policyId], references: [id], onDelete: SetNull)
  customerId String? @db.Uuid
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  amount Decimal @db.Decimal(12, 2)
  status CommissionStatus @default(PENDING)
  earnedAt DateTime @default(now())
  paidAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([branchId, status, earnedAt])
}
