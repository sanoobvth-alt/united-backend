const bearer = { bearerAuth: [] };
const response = {
  description: "Successful response",
  content: {
    "application/json": { schema: { $ref: "#/components/schemas/Success" } },
  },
};
const errors = {
  400: { description: "Invalid request" },
  401: { description: "Authentication required" },
  403: { description: "Role is not allowed to perform this action" },
  404: { description: "Record not found" },
  409: {
    description: "Record state or configuration conflicts with this request",
  },
};
const id = {
  name: "id",
  in: "path",
  required: true,
  schema: { type: "string", format: "uuid" },
};
const listParams = [
  {
    name: "page",
    in: "query",
    schema: { type: "integer", minimum: 1, default: 1 },
  },
  {
    name: "limit",
    in: "query",
    schema: { type: "integer", minimum: 1, maximum: 100, default: 10 },
  },
  { name: "search", in: "query", schema: { type: "string" } },
  {
    name: "sortOrder",
    in: "query",
    schema: { type: "string", enum: ["asc", "desc"], default: "desc" },
  },
];
const insurerListParams = [
  ...listParams,
  {
    name: "isActive",
    in: "query",
    schema: { type: "boolean", description: "Set true to return active insurers for policy forms." },
  },
];
const ref = (name) => ({ $ref: `#/components/schemas/${name}` });
const body = (name) => ({
  required: true,
  content: { "application/json": { schema: ref(name) } },
});
const op = (tag, summary, options = {}) => ({
  tags: [tag],
  summary,
  ...(options.description ? { description: options.description } : {}),
  ...(options.parameters ? { parameters: options.parameters } : {}),
  ...(options.schema ? { requestBody: body(options.schema) } : {}),
  ...(options.public ? { security: [] } : {}),
  responses: {
    ...errors,
    [options.status ?? 200]: response,
    ...(options.responses ?? {}),
  },
});
const resource = (
  path,
  tag,
  schema,
  { create = true, update = true, remove = false } = {},
) => ({
  [path]: {
    get: op(tag, `List ${tag.toLowerCase()} records`, {
      parameters: listParams,
    }),
    ...(create
      ? {
          post: op(tag, `Create ${tag.toLowerCase()}`, {
            schema: `Create${schema}`,
            status: 201,
          }),
        }
      : {}),
  },
  [`${path}/{id}`]: {
    parameters: [id],
    get: op(tag, `Get ${tag.toLowerCase()} by ID`),
    ...(update
      ? {
          patch: op(tag, `Update ${tag.toLowerCase()}`, {
            schema: `Update${schema}`,
          }),
        }
      : {}),
    ...(remove ? { delete: op(tag, `Delete ${tag.toLowerCase()}`) } : {}),
  },
});
const model = (properties, required = []) => ({
  type: "object",
  properties,
  ...(required.length ? { required } : {}),
});
const nullableString = { type: "string", nullable: true };
const uuid = { type: "string", format: "uuid" };
const amount = { type: "number", minimum: 0 };
const branchFields = {
  name: { type: "string" },
  code: { type: "string", readOnly: true, description: "Generated by the backend." },
  username: { type: "string" },
  password: { type: "string", format: "password" },
  phone: nullableString,
  email: { type: "string", format: "email", nullable: true },
  address: nullableString,
  status: { type: "string", enum: ["ACTIVE", "INACTIVE"] },
};
const staffFields = {
  name: { type: "string" },
  phone: { type: "string" },
  email: { type: "string", format: "email", nullable: true },
  designation: nullableString,
  status: { type: "string", enum: ["ACTIVE", "INACTIVE"] },
  joiningDate: { type: "string", format: "date-time", nullable: true },
};
const customerFields = {
  name: { type: "string" },
  phone: { type: "string" },
  email: { type: "string", format: "email", nullable: true },
  dob: { type: "string", format: "date-time", nullable: true },
  gender: nullableString,
  address: nullableString,
  notes: nullableString,
  category: { type: "string", enum: ["UNITED_PARTY", "THIRD_PARTY"] },
  status: { type: "string", enum: ["ACTIVE", "INACTIVE"] },
  staffId: { ...uuid, nullable: true },
};
const policyFields = {
  customerId: uuid,
  policyNumber: { type: "string" },
  insurer: { type: "string", readOnly: true },
  insurerType: { type: "string", enum: ["UNITED", "THIRD_PARTY"] },
  insurerId: { ...uuid, nullable: true, description: "Required for THIRD_PARTY insurerType; omitted for UNITED." },
  product: { type: "string" },
  premium: amount,
  startDate: { type: "string", format: "date-time" },
  expiryDate: { type: "string", format: "date-time" },
  status: { type: "string", enum: ["ACTIVE", "EXPIRED", "CANCELLED"] },
  insuranceClass: { type: "string", enum: ["FIRST_CLASS", "THIRD_PARTY"] },
  vehicleNumber: {
    ...nullableString,
    description: "Required for FIRST_CLASS policies; omitted for THIRD_PARTY.",
  },
  vehicleType: {
    ...nullableString,
    description: "Required for FIRST_CLASS policies; omitted for THIRD_PARTY.",
  },
  vehicleDetails: nullableString,
  amountPartOne: { ...amount, nullable: true },
  amountPartTwo: { ...amount, nullable: true },
};
const policyResponseFields = {
  ...policyFields,
  customerName: {
    type: "string",
    nullable: true,
    readOnly: true,
    description: "Linked customer's name, or null if no customer is linked.",
  },
};
const dateFilters = ["from", "to"].map((name) => ({
  name,
  in: "query",
  schema: { type: "string", format: "date-time" },
}));

const paths = {
  "/health": { get: op("Health", "Health check", { public: true }) },
  "/api/auth/admin/login": {
    post: op("Authentication", "Admin login", {
      schema: "Login",
      public: true,
    }),
  },
  "/api/auth/branch/login": {
    post: op("Authentication", "Branch login", {
      schema: "Login",
      public: true,
    }),
  },
  "/api/dev/branches": {
    get: op("Development", "List branch login identifiers", {
      description:
        "Available only outside production and only to authenticated admins. Returns branch id, name, code, username, and status; passwords and password hashes are never returned.",
    }),
  },
  "/api/branches": {
    get: op("Branches", "List branches", { parameters: listParams }),
    post: op("Branches", "Create branch", {
      schema: "CreateBranch",
      status: 201,
    }),
  },
  "/api/branches/{id}": {
    parameters: [id],
    get: op("Branches", "Get branch"),
    patch: op("Branches", "Update branch", { schema: "UpdateBranch" }),
  },
  ...resource("/api/staff", "Staff", "Staff", { remove: true }),
  ...resource("/api/customers", "Customers", "Customer", { remove: true }),
  "/api/policies": {
    get: op("Policies", "List policies", {
      parameters: listParams,
      responses: {
        200: {
          description: "Paginated policy list including linked customer names",
          content: {
            "application/json": {
              schema: ref("PolicyListResponse"),
            },
          },
        },
      },
    }),
    post: op("Policies", "Create policy", {
      schema: "CreatePolicy",
      status: 201,
    }),
  },
  "/api/policies/{id}": {
    parameters: [id],
    get: op("Policies", "Get policy by ID"),
    patch: op("Policies", "Update policy", { schema: "UpdatePolicy" }),
  },
  "/api/insurers": {
    get: op("Insurers", "List insurers", { parameters: insurerListParams }),
    post: op("Insurers", "Create insurer", { schema: "CreateInsurer", status: 201 }),
  },
  "/api/insurers/{id}": {
    parameters: [id],
    patch: op("Insurers", "Update insurer", { schema: "UpdateInsurer" }),
    delete: op("Insurers", "Deactivate insurer"),
  },
  "/api/policies/{id}/document-requirements": {
    get: op("Policies", "Check required policy documents", {
      parameters: [id],
    }),
  },
  "/api/documents": {
    get: op("Documents", "List customer and policy documents", {
      parameters: listParams,
    }),
  },
  "/api/documents/upload": {
    post: {
      ...op(
        "Documents",
        "Upload an RC, insurance copy, or other policy document",
        { status: 201 },
      ),
      requestBody: {
        required: true,
        content: { "multipart/form-data": { schema: ref("DocumentUpload") } },
      },
    },
  },
  "/api/documents/{id}": {
    parameters: [id],
    get: op("Documents", "Get document metadata"),
    delete: op("Documents", "Delete document"),
  },
  "/api/documents/{id}/content": {
    parameters: [id],
    get: {
      ...op("Documents", "Download document"),
      responses: {
        ...errors,
        200: {
          description: "Document bytes",
          content: {
            "application/octet-stream": {
              schema: { type: "string", format: "binary" },
            },
          },
        },
      },
    },
  },
  "/api/accounts/transactions": {
    get: op("Accounts", "List customer account entries", {
      parameters: [
        ...listParams,
        { name: "branchId", in: "query", schema: uuid },
        ...dateFilters,
        { name: "customerId", in: "query", schema: uuid },
        { name: "policyId", in: "query", schema: uuid },
        {
          name: "type",
          in: "query",
          schema: { type: "string", enum: ["CHARGE", "PAYMENT", "CREDIT"] },
        },
      ],
    }),
    post: op("Accounts", "Record customer charge, payment, or credit", {
      schema: "CreateAccountEntry",
      status: 201,
      description:
        "A CHARGE increases the outstanding balance. PAYMENT and CREDIT entries reduce it. A PAYMENT requires policyId, and only one PAYMENT entry is allowed per policy.",
    }),
  },
  "/api/accounts/customers/{customerId}": {
    get: op("Accounts", "Get customer ledger and balance", {
      parameters: [
        { name: "customerId", in: "path", required: true, schema: uuid },
        ...dateFilters,
      ],
    }),
  },
  "/api/expenses": {
    get: op("Expenses", "List expenses", {
      parameters: [
        ...listParams,
        { name: "branchId", in: "query", schema: uuid },
        ...dateFilters,
        { name: "category", in: "query", schema: { type: "string" } },
      ],
    }),
    post: op("Expenses", "Create expense", {
      schema: "CreateExpense",
      status: 201,
    }),
  },
  "/api/expenses/{id}": {
    parameters: [id],
    get: op("Expenses", "Get expense by ID"),
    patch: op("Expenses", "Update expense", { schema: "UpdateExpense" }),
    delete: op("Expenses", "Delete expense"),
  },
  "/api/daily-closings": {
    get: op("Daily Closings", "List daily closings", {
      parameters: [
        ...listParams,
        ...dateFilters,
        {
          name: "status",
          in: "query",
          schema: { type: "string", enum: ["DRAFT", "SUBMITTED"] },
        },
        { name: "branchId", in: "query", schema: uuid },
      ],
    }),
    post: op("Daily Closings", "Create daily closing", {
      schema: "CreateDailyClosing",
      status: 201,
    }),
  },
  "/api/daily-closings/{id}": {
    parameters: [id],
    get: op("Daily Closings", "Get daily closing"),
    patch: op("Daily Closings", "Update draft daily closing", {
      schema: "UpdateDailyClosing",
    }),
  },
  "/api/daily-closings/{id}/submit": {
    parameters: [id],
    post: op("Daily Closings", "Submit daily closing"),
  },
  "/api/reports/status": {
    get: op("Reports", "Policy and customer status report", {
      parameters: [
        ...dateFilters,
        { name: "branchId", in: "query", schema: uuid },
        {
          name: "category",
          in: "query",
          schema: { type: "string", enum: ["UNITED_PARTY", "THIRD_PARTY"] },
        },
        {
          name: "insuranceClass",
          in: "query",
          schema: { type: "string", enum: ["FIRST_CLASS", "THIRD_PARTY"] },
        },
        {
          name: "status",
          in: "query",
          schema: { type: "string", enum: ["ACTIVE", "EXPIRED", "CANCELLED"] },
        },
      ],
    }),
  },
  "/api/reports/financial": {
    get: op(
      "Reports",
      "Customer collections, expenses, and policy amount components",
      {
        parameters: [
          ...dateFilters,
          { name: "branchId", in: "query", schema: uuid },
        ],
      },
    ),
  },
};

export const openapiSpec = {
