generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

//
// =========================
// ENUMS
// =========================
//

enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum Status {
  ACTIVE
  INACTIVE
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CREDIT_CARD
  PAYPAL
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

//
// =========================
// AUTH MODELS
// =========================
//

model User {
  id        String  @id @default(uuid())
  firstName String
  lastName  String
  email     String  @unique
  password  String
  role      Role
  isActive  Boolean @default(false)

  student    Student?    @relation("UserStudent")
  instructor Instructor?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation("UserStudent", fields: [userId], references: [id], onDelete: Cascade)

  phone       String
  image       String?
  gender      Gender
  dateOfBirth DateTime

  createdById String?
  updatedById String?
  isDeleted   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments  Enrollment[]
  reviews      Review[]
  testimonials Testimonial[]
  payments     Payment[]
}

model Instructor {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  phone       String
  image       String?
  bio         String?
  gender      Gender
  dateOfBirth DateTime

  createdById String?
  updatedById String?
  isDeleted   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses Course[]
}

//
// =========================
// COURSE MODELS
// =========================
//

model CourseCategory {
  id    String @id @default(uuid())
  name  String
  slug  String @unique
  image String

  courses Course[]

  createdById String?
  updatedById String?
  isDeleted   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id          String @id @default(uuid())
  title       String
  slug        String @unique
  description String
  content     String
  duration    String //dynamic calculated from curriculum
  image       String
  status      Status @default(ACTIVE)

  categoryId String
  category   CourseCategory @relation(fields: [categoryId], references: [id])

  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id])

  createdById String?
  updatedById String?
  isDeleted   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  curriculum  Curriculum[]
  overview    Overview[]
  enrollments Enrollment[]
  reviews     Review[]
  payments    Payment[]
}

model Overview {
  id        String  @id @default(uuid())
  courseId  String
  course    Course  @relation(fields: [courseId], references: [id])
  title     String
  isDeleted Boolean @default(false)
}

model Curriculum {
  id       String @id @default(uuid())
  title    String
  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  lessons Lesson[]

  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lesson {
  id       String @id @default(uuid())
  title    String
  duration String

  curriculumId String
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// =========================
// BLOG MODELS
// =========================
//

model BlogCategory {
  id   String @id @default(uuid())
  name String
  slug String @unique

  blogs Blog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Blog {
  id          String        @id @default(uuid())
  title       String
  slug        String        @unique
  description String
  content     String
  image       String
  status      PublishStatus @default(DRAFT)

  categoryId String
  category   BlogCategory @relation(fields: [categoryId], references: [id])

  createdById String?
  updatedById String?
  isDeleted   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags Tag[]
}

model Tag {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blogs Blog[]
}

//
// =========================
// ENROLLMENT & PAYMENT
// =========================
//

model Enrollment {
  id String @id @default(uuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  status   EnrollmentStatus @default(ACTIVE)
  progress Int              @default(0)

  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  payments Payment[]
}

model Payment {
  id String @id @default(uuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  amount        Float
  paymentMethod PaymentMethod
  transactionId String        @unique
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?

  createdAt    DateTime    @default(now())
  enrollment   Enrollment? @relation(fields: [enrollmentId], references: [id])
  enrollmentId String?
}

model Review {
  id      String  @id @default(uuid())
  rating  Int
  comment String?

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  createdAt DateTime @default(now())
}

//
// =========================
// GENERAL CONTENT MODELS
// =========================
//

model Spotlight {
  id          String @id @default(uuid())
  title       String
  description String
  status      Status @default(ACTIVE)
  image       String

  createdById String?
  updatedById String?
  isDeleted   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model About {
  id          String @id @default(uuid())
  title       String
  description String
  image       String
  status      Status @default(ACTIVE)

  createdById String?
  updatedById String?
  isDeleted   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id          String  @id @default(uuid())
  studentId   String
  student     Student @relation(fields: [studentId], references: [id])
  description String

  createdAt DateTime @default(now())
}
